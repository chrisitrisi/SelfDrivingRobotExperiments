			)
			(justify left top)
		)
		(uuid "d3f71a25-d116-4320-bf50-471724921751")
	)
	(text "C14=100n + C21=2.2u at VDD; C15=10n at VDDIO.\nAP_CS=3.3V, AD0=GND, FSYNC=GND. ICM driver required."
		(exclude_from_sim no)
